{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/asimfish/super_agent_presentation/evals/schema/rating-batch.schema.json",
  "title": "One rater's blind A/B rating batch",
  "$comment": "Only A/B labels are permitted; condition identities belong in the private assignment key.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "study_id", "rater_id", "qualified", "independent", "ratings"
  ],
  "properties": {
    "$schema": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "schema_version": {"const": "1.0"},
    "study_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"},
    "rater_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"},
    "qualified": {"type": "boolean"},
    "independent": {"type": "boolean"},
    "ratings": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/pairRating"}
    }
  },
  "$defs": {
    "score": {"type": "integer", "minimum": 1, "maximum": 5},
    "scores": {
      "type": "object", "additionalProperties": false,
      "required": [
        "task_fidelity", "information_architecture", "readability_and_scannability",
        "completeness_and_actionability", "evidence_calibration",
        "visual_display_fitness", "concision_and_proportionality"
      ],
      "properties": {
        "task_fidelity": {"$ref": "#/$defs/score"},
        "information_architecture": {"$ref": "#/$defs/score"},
        "readability_and_scannability": {"$ref": "#/$defs/score"},
        "completeness_and_actionability": {"$ref": "#/$defs/score"},
        "evidence_calibration": {"$ref": "#/$defs/score"},
        "visual_display_fitness": {"$ref": "#/$defs/score"},
        "concision_and_proportionality": {"$ref": "#/$defs/score"}
      }
    },
    "criticalError": {
      "type": "object", "additionalProperties": false,
      "required": ["label", "evidence"],
      "properties": {
        "label": {
          "enum": [
            "fabricated_evidence",
            "numeric_or_unit_drift",
            "negation_or_modality_drift",
            "false_completion_or_stale_status",
            "unsupported_causality_significance_or_ranking",
            "incomparable_protocol_ranking",
            "secret_leakage",
            "materially_misleading_visual",
            "ignored_explicit_format"
          ]
        },
        "evidence": {
          "type": "string", "minLength": 1, "maxLength": 1000, "pattern": "\\S"
        }
      }
    },
    "comprehension": {
      "type": "object", "additionalProperties": false,
      "required": [
        "status_correct", "strongest_evidence_correct", "next_action_or_limit_correct",
        "elapsed_seconds"
      ],
      "properties": {
        "status_correct": {"type": "boolean"},
        "strongest_evidence_correct": {"type": "boolean"},
        "next_action_or_limit_correct": {"type": "boolean"},
        "elapsed_seconds": {"type": "number", "minimum": 0, "maximum": 3600}
      }
    },
    "sideRating": {
      "type": "object", "additionalProperties": false,
      "required": ["scores", "critical_errors", "semantic_slots_present", "comprehension"],
      "properties": {
        "scores": {"$ref": "#/$defs/scores"},
        "critical_errors": {
          "type": "array", "maxItems": 20, "uniqueItems": true,
          "items": {"$ref": "#/$defs/criticalError"}
        },
        "semantic_slots_present": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}
        },
        "comprehension": {"$ref": "#/$defs/comprehension"}
      }
    },
    "pairRating": {
      "type": "object", "additionalProperties": false,
      "required": ["pair_id", "sides", "preference", "notes"],
      "properties": {
        "pair_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,119}$"},
        "sides": {
          "type": "object", "additionalProperties": false,
          "required": ["A", "B"],
          "properties": {
            "A": {"$ref": "#/$defs/sideRating"},
            "B": {"$ref": "#/$defs/sideRating"}
          }
        },
        "preference": {"enum": ["A", "B", "tie"]},
        "notes": {"type": "string", "maxLength": 2000}
      }
    }
  }
}
