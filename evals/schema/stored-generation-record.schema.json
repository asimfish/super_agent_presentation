{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/asimfish/super_agent_presentation/evals/schema/stored-generation-record.schema.json",
  "title": "Controller-stored generation record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "study_id", "unit_id", "case_id", "model_id", "context_id",
    "seed", "condition", "host", "host_version", "model", "model_revision",
    "prompt_sha256", "response_sha256", "transcript_sha256", "artifacts", "usage",
    "observations", "machine_evaluation"
  ],
  "properties": {
    "$schema": {"const": "stored-generation-record.schema.json"},
    "schema_version": {"const": "1.0"},
    "study_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"},
    "unit_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,239}$"},
    "case_id": {
      "type": "string", "maxLength": 80,
      "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
    },
    "model_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"},
    "context_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"},
    "seed": {"type": "integer", "minimum": 0, "maximum": 2147483647},
    "condition": {"enum": ["baseline", "framework"]},
    "host": {"type": "string", "minLength": 1},
    "host_version": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "model_revision": {"type": "string", "minLength": 1},
    "prompt_sha256": {"$ref": "#/$defs/sha256"},
    "response_sha256": {"$ref": "#/$defs/sha256"},
    "transcript_sha256": {"$ref": "#/$defs/nullableSha256"},
    "artifacts": {
      "type": "array", "maxItems": 32,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "usage": {"$ref": "#/$defs/usage"},
    "observations": {"$ref": "#/$defs/observations"},
    "machine_evaluation": {"$ref": "#/$defs/machineEvaluation"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableSha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "nullableBoolean": {"oneOf": [{"type": "boolean"}, {"type": "null"}]},
    "nullableNonnegativeInteger": {
      "oneOf": [
        {"type": "integer", "minimum": 0, "maximum": 1000000000000},
        {"type": "null"}
      ]
    },
    "nullableNonnegativeNumber": {
      "oneOf": [{"type": "number", "minimum": 0}, {"type": "null"}]
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "media_type"],
      "properties": {
        "path": {
          "type": "string", "minLength": 1, "maxLength": 240,
          "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._-]*/){0,11}[A-Za-z0-9][A-Za-z0-9._-]*\\.(?:avif|gif|jpe?g|png|svg|webp)$"
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "media_type": {
          "enum": ["image/avif", "image/gif", "image/jpeg", "image/png", "image/svg+xml", "image/webp"]
        }
      }
    },
    "usage": {
      "type": "object", "additionalProperties": false,
      "required": [
        "input_tokens", "cached_input_tokens", "output_tokens", "latency_ms",
        "context_occupancy_percent", "compaction_observed"
      ],
      "properties": {
        "input_tokens": {"$ref": "#/$defs/nullableNonnegativeInteger"},
        "cached_input_tokens": {"$ref": "#/$defs/nullableNonnegativeInteger"},
        "output_tokens": {"$ref": "#/$defs/nullableNonnegativeInteger"},
        "latency_ms": {"type": "integer", "minimum": 0, "maximum": 1000000000000},
        "context_occupancy_percent": {
          "oneOf": [{"type": "number", "minimum": 0, "maximum": 100}, {"type": "null"}]
        },
        "compaction_observed": {"$ref": "#/$defs/nullableBoolean"}
      }
    },
    "observations": {
      "type": "object", "additionalProperties": false,
      "required": [
        "telemetry_source", "host_activation_observed", "skill_read",
        "checkpoint_created", "checkpoint_reloaded", "checkpoint_audit_passed",
        "final_audit_passed", "checkpoint_receipt_verified", "output_token_cap_enforced"
      ],
      "properties": {
        "telemetry_source": {"enum": ["manual", "host_adapter"]},
        "host_activation_observed": {"$ref": "#/$defs/nullableBoolean"},
        "skill_read": {"$ref": "#/$defs/nullableBoolean"},
        "checkpoint_created": {"$ref": "#/$defs/nullableBoolean"},
        "checkpoint_reloaded": {"$ref": "#/$defs/nullableBoolean"},
        "checkpoint_audit_passed": {"$ref": "#/$defs/nullableBoolean"},
        "final_audit_passed": {"$ref": "#/$defs/nullableBoolean"},
        "checkpoint_receipt_verified": {"$ref": "#/$defs/nullableBoolean"},
        "output_token_cap_enforced": {"$ref": "#/$defs/nullableBoolean"}
      }
    },
    "machineCheck": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "passed", "message", "observed"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "type": {"type": "string", "minLength": 1},
        "passed": {"type": "boolean"},
        "message": {"type": "string", "minLength": 1},
        "observed": {"type": "string", "minLength": 1}
      }
    },
    "machineEvaluation": {
      "type": "object", "additionalProperties": false,
      "required": [
        "case_id", "response", "passed", "checks_passed", "checks_total", "word_count",
        "heading_count", "markdown_table_count", "image_count", "image_scan_truncated",
        "checks", "semantic_limit"
      ],
      "properties": {
        "case_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "response": {"type": "string", "minLength": 1},
        "passed": {"type": "boolean"},
        "checks_passed": {"type": "integer", "minimum": 0},
        "checks_total": {"type": "integer", "minimum": 0},
        "word_count": {"type": "integer", "minimum": 0},
        "heading_count": {"type": "integer", "minimum": 0},
        "markdown_table_count": {"type": "integer", "minimum": 0},
        "image_count": {"type": "integer", "minimum": 0},
        "image_scan_truncated": {"type": "boolean"},
        "checks": {"type": "array", "items": {"$ref": "#/$defs/machineCheck"}},
        "semantic_limit": {"type": "string", "minLength": 1}
      }
    }
  }
}
