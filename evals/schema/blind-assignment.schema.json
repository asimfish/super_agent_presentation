{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/asimfish/super_agent_presentation/evals/schema/blind-assignment.schema.json",
  "title": "Private randomized blind-assignment key",
  "$comment": "This file reveals condition identities. The controller stores it mode 0600, rejects symbolic-link targets, and never copies it into the blind packet.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "study_id", "assignments"],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "schema_version": {"const": "1.0"},
    "study_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"},
    "assignments": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/assignment"}
    }
  },
  "$defs": {
    "assignment": {
      "type": "object", "additionalProperties": false,
      "required": ["pair_id", "case_id", "model_id", "context_id", "seed", "A", "B"],
      "properties": {
        "pair_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,119}$"},
        "case_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "model_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,79}$"},
        "context_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"},
        "seed": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "A": {"enum": ["baseline", "framework"]},
        "B": {"enum": ["baseline", "framework"]}
      },
      "oneOf": [
        {"properties": {"A": {"const": "baseline"}, "B": {"const": "framework"}}},
        {"properties": {"A": {"const": "framework"}, "B": {"const": "baseline"}}}
      ]
    }
  }
}
