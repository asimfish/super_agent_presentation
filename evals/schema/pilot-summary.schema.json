{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/asimfish/super_agent_presentation/evals/schema/pilot-summary.schema.json",
  "title": "Non-claiming pilot generation summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schema_version", "study_id", "study_kind", "input_receipts",
    "generation", "claim", "limitations"
  ],
  "properties": {
    "$schema": {"const": "pilot-summary.schema.json"},
    "schema_version": {"const": "1.0"},
    "study_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"},
    "study_kind": {"const": "pilot"},
    "input_receipts": {"$ref": "#/$defs/inputReceipts"},
    "generation": {"$ref": "#/$defs/generation"},
    "claim": {"$ref": "#/$defs/claim"},
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1, "maxLength": 2000}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableNonnegativeNumber": {
      "oneOf": [{"type": "number", "minimum": 0}, {"type": "null"}]
    },
    "inputReceipts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_sha256", "cases_sha256", "input_artifacts_sha256"],
      "properties": {
        "plan_sha256": {"$ref": "#/$defs/sha256"},
        "cases_sha256": {"$ref": "#/$defs/sha256"},
        "input_artifacts_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "conditionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_count", "machine_check_pass_rate", "machine_response_pass_count",
        "median_output_tokens", "median_latency_ms", "skill_read_count",
        "checkpoint_audit_pass_count"
      ],
      "properties": {
        "record_count": {"type": "integer", "minimum": 0},
        "machine_check_pass_rate": {
          "oneOf": [
            {"type": "number", "minimum": 0, "maximum": 1},
            {"type": "null"}
          ]
        },
        "machine_response_pass_count": {"type": "integer", "minimum": 0},
        "median_output_tokens": {"$ref": "#/$defs/nullableNonnegativeNumber"},
        "median_latency_ms": {"$ref": "#/$defs/nullableNonnegativeNumber"},
        "skill_read_count": {"type": "integer", "minimum": 0},
        "checkpoint_audit_pass_count": {"type": "integer", "minimum": 0}
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_count", "pair_count", "conditions",
        "paired_output_token_overhead_median"
      ],
      "properties": {
        "record_count": {"type": "integer", "minimum": 0},
        "pair_count": {"type": "integer", "minimum": 0},
        "conditions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["baseline", "framework"],
          "properties": {
            "baseline": {"$ref": "#/$defs/conditionSummary"},
            "framework": {"$ref": "#/$defs/conditionSummary"}
          }
        },
        "paired_output_token_overhead_median": {
          "oneOf": [{"type": "number"}, {"type": "null"}]
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "effectiveness_claim_eligible", "reason"],
      "properties": {
        "status": {"const": "insufficient_evidence"},
        "effectiveness_claim_eligible": {"const": false},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    }
  }
}
