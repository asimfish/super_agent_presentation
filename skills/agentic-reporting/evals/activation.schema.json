{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/asimfish/super_agent_presentation/activation.schema.json",
  "title": "Agentic reporting declarative activation contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "benchmark_id", "skill", "description",
    "claim_boundary", "rubrics", "cases"
  ],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "schema_version": {"const": "1.0"},
    "benchmark_id": {"type": "string", "minLength": 1},
    "skill": {"const": "agentic-reporting"},
    "description": {"type": "string", "minLength": 1},
    "claim_boundary": {"type": "string", "minLength": 1},
    "rubrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["security", "correctness", "discoverability", "effectiveness", "efficiency"],
      "properties": {
        "security": {"$ref": "#/$defs/rubric"},
        "correctness": {"$ref": "#/$defs/rubric"},
        "discoverability": {"$ref": "#/$defs/rubric"},
        "effectiveness": {"$ref": "#/$defs/rubric"},
        "efficiency": {"$ref": "#/$defs/rubric"}
      }
    },
    "cases": {"type": "array", "minItems": 8, "items": {"$ref": "#/$defs/case"}}
  },
  "allOf": [
    {"properties": {"cases": {"contains": {"properties": {"category": {"const": "explicit_positive"}}}}}},
    {"properties": {"cases": {"contains": {"properties": {"category": {"const": "natural_positive"}}}}}},
    {"properties": {"cases": {"contains": {"properties": {"category": {"const": "adjacent_negative"}}}}}},
    {"properties": {"cases": {"contains": {"properties": {"category": {"const": "explicit_exclusion"}}}}}},
    {"properties": {"cases": {"contains": {"properties": {"rubric_categories": {"contains": {"const": "security"}}}}}}},
    {"properties": {"cases": {"contains": {"properties": {"rubric_categories": {"contains": {"const": "correctness"}}}}}}},
    {"properties": {"cases": {"contains": {"properties": {"rubric_categories": {"contains": {"const": "discoverability"}}}}}}},
    {"properties": {"cases": {"contains": {"properties": {"rubric_categories": {"contains": {"const": "effectiveness"}}}}}}},
    {"properties": {"cases": {"contains": {"properties": {"rubric_categories": {"contains": {"const": "efficiency"}}}}}}}
  ],
  "$defs": {
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion", "assessment"],
      "properties": {
        "criterion": {"type": "string", "minLength": 1},
        "assessment": {"enum": ["host_or_human", "host_observation", "human_comparative", "local_proxy_plus_telemetry"]}
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "modules"],
      "properties": {
        "mode": {
          "enum": [
            "concise-answer", "implementation-handoff", "status-update",
            "investigation-report", "experiment-report", "decision-brief",
            "academic-synthesis", "review-report", "incident-update",
            "postmortem", "risk-report"
          ]
        },
        "modules": {
          "type": "array", "maxItems": 2, "uniqueItems": true,
          "items": {"enum": ["visuals", "tables", "conclusions", "evidence", "academic-display"]}
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "category", "prompt", "expected_activation", "expected_route",
        "reason", "expected_behavior", "rubric_categories", "tags"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "category": {"enum": ["explicit_positive", "natural_positive", "adjacent_negative", "explicit_exclusion"]},
        "prompt": {"type": "string", "minLength": 1},
        "expected_activation": {"type": "boolean"},
        "expected_route": {"oneOf": [{"$ref": "#/$defs/route"}, {"type": "null"}]},
        "reason": {"type": "string", "minLength": 1},
        "expected_behavior": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "rubric_categories": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["security", "correctness", "discoverability", "effectiveness", "efficiency"]}
        },
        "tags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "allOf": [
        {
          "if": {"properties": {"category": {"enum": ["explicit_positive", "natural_positive"]}}, "required": ["category"]},
          "then": {"properties": {"expected_activation": {"const": true}, "expected_route": {"$ref": "#/$defs/route"}}}
        },
        {
          "if": {"properties": {"category": {"enum": ["adjacent_negative", "explicit_exclusion"]}}, "required": ["category"]},
          "then": {"properties": {"expected_activation": {"const": false}, "expected_route": {"type": "null"}}}
        }
      ]
    }
  }
}
