      "concise-answer": {
        "summary": "A direct, proportional answer for a bounded question or small handoff.",
        "intent_signals": ["short answer", "answer in at most", "in one sentence", "in two sentences", "answer yes or no"],
      "file": "modes/concise-answer.md",
      "signals": [
        "bounded question",
        "quick factual result",
        "short final status",
        "at most two compact sentences",
        "answer in at most two",
        "no durable report requested",
        "简短回答",
        "直接回答",
        "一句话",
        "简要结果"
      ],
      "default_modules": [],
      "required_semantics": [
        "outcome",
        "boundary"
      ],
      "template": "assets/templates/concise-answer.md"
    },
      "implementation-handoff": {
        "summary": "A completed, partial, or blocked engineering handoff with verification and changed artifacts.",
        "intent_signals": ["implementation handoff", "final engineering handoff", "give me a handoff", "report changed files"],
