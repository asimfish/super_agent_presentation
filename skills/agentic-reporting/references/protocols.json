      "signals": [
        "implemented",
        "fixed",
        "built",
        "changed files",
        "tests run",
        "final engineering handoff",
        "实现",
        "修复",
        "构建",
        "修改文件",
        "测试结果",
        "代码交付"
      ],
      "default_modules": [
        "evidence"
      ],
      "required_semantics": [
        "outcome",
        "changes",
        "verification",
        "boundary",
        "next_action"
      ],
      "template": "assets/templates/implementation-handoff.md"
    },
